POSTGRES_DB=geek_monitor
POSTGRES_USER=geek_monitor
POSTGRES_PASSWORD=replace-with-a-long-random-password
GEEK_MONITOR_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
GEEK_MONITOR_BIND=127.0.0.1
GEEK_MONITOR_HOST_PORT=8080
# Set true when the browser connects through HTTPS; direct HTTP needs false.
GEEK_MONITOR_SECURE_COOKIE=false
GEEK_MONITOR_IMAGE=geek-monitor:local
GEEK_MONITOR_DOCKERFILE=src/main/docker/Dockerfile.jvm
POSTGRES_HOST_PORT=55432
MONITOR_ALLOWED_CIDRS=none
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_START_TLS=REQUIRED
